### Coding solutions
1)
```js
function unique(arr){
  return [...new Set(arr)];
}
```
2)
```js
function sumArray(arr){
  let sum = 0;
  for (const x of arr) sum += x;
  return sum;
}
```
3)
```js
class Student{
  constructor(name,id){ this.name = name; this.id = id; }
  info(){ return `${this.name} (${this.id})`; }
}
```
